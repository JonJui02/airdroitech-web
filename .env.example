# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# Resend — transactional email for the contact and application forms.
# IMPORTANT: the sending domain MUST be a subdomain (mail.airdroitech.com).
# airdroitech.com's MX records point at Proofpoint (mxa/mxb-009aec01.gslb.pphosted.com)
# and its SPF is "v=spf1 include:spf-009aec01.pphosted.com ~all". Sending from the
# apex would require editing those records and risks breaking inbound company mail.
RESEND_API_KEY=
MAIL_FROM="AirdroiTech Website <no-reply@mail.airdroitech.com>"
MAIL_TO=info@airdroitech.com

# Vercel Blob — CV / resume storage for job applications.
# Check the store's region against the PDPA answer before going live.
BLOB_READ_WRITE_TOKEN=

# Upload limits, mirrored client and server side.
MAX_UPLOAD_BYTES=12582912

# Public site origin, used for canonicals, sitemap and OpenGraph.
NEXT_PUBLIC_SITE_URL=https://airdroitech.com
